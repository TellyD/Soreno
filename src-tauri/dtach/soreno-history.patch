+/*
+** Output history. dtach normally drops output while no client is attached;
+** a new terminal instead rebuilds its scrollback and screen from this
+** replay, and the markers let the client separate it from live output.
+*/
+#define HISTORY_SIZE (1024 * 1024)
+#define HISTORY_ALIGN_LIMIT (64 * 1024)
+#define HISTORY_STALL_MS 10000
+#define HISTORY_BEGIN "\033]5379;dtach-history-begin\007"
+#define HISTORY_END "\033]5379;dtach-history-end\007"
+#define MODE_PARAMS 64
+
+enum mode_parse
+{
+	MP_GROUND,
+	MP_ESC,
+	MP_CSI,
+	MP_PARAMS,
+	MP_BANG,
+	MP_PRIVATE,
+	MP_IGNORE,
+	MP_STRING,
+	MP_STRING_ESC
+};
+
+/* Terminal modes that change how a terminal renders or reports input. */
+struct modes
+{
+	enum mode_parse parse;
+	char params[MODE_PARAMS];
+	size_t nparams;
+	int overflow;
+	unsigned int enabled;
+	/* Mouse protocol and encoding modes, or 0 for none and the default. */
+	int mouse;
+	int encoding;
+};
+
+/* The alternate screen comes first: later modes are global. */
+static const struct
+{
+	int mode;
+	int initially;
+} tracked_modes[] = {
+	{1049, 0}, {1, 0}, {7, 1}, {25, 1}, {66, 0}, {1004, 0}, {2004, 0},
+};
+#define TRACKED_MODES (sizeof(tracked_modes) / sizeof(tracked_modes[0]))
+
+static unsigned char history[HISTORY_SIZE];
+/* Index of the oldest retained byte, and the number retained. */
+static size_t history_head, history_len;
+static int history_truncated;
+/* Modes in effect just before the oldest retained byte. */
+static struct modes history_base;
+
+static void
+modes_reset(struct modes *m)
+{
+	size_t i;
+
+	memset(m, 0, sizeof(*m));
+	for (i = 0; i < TRACKED_MODES; i++)
+		if (tracked_modes[i].initially)
+			m->enabled |= 1u << i;
+}
+
+static void
+modes_set(struct modes *m, int mode, int on)
+{
+	size_t i;
+
+	switch (mode)
+	{
+	case 9: case 1000: case 1002: case 1003:
+		/* The last protocol set wins; resetting any disables tracking. */
+		m->mouse = on ? mode : 0;
+		return;
+	case 1006: case 1016:
+		/* xterm.js resets the encoding when either mode is reset. */
+		m->encoding = on ? mode : 0;
+		return;
+	case 1005: case 1015:
+		/* xterm.js ignores these, keeping the current encoding. */
+		return;
+	case 47: case 1047:
+		mode = 1049;
+		break;
+	}
+	for (i = 0; i < TRACKED_MODES; i++)
+	{
+		if (tracked_modes[i].mode != mode)
+			continue;
+		if (on)
+			m->enabled |= 1u << i;
+		else
+			m->enabled &= ~(1u << i);
+		return;
+	}
+}
+
+/* DECSTR resets the flags but keeps the screen and the mouse modes. */
+static void
+modes_soft_reset(struct modes *m)
+{
+	size_t i;
+
+	for (i = 0; i < TRACKED_MODES; i++)
+		if (tracked_modes[i].mode != 1049)
+			modes_set(m, tracked_modes[i].mode,
+				tracked_modes[i].initially);
+}
+
+static void
+modes_apply(struct modes *m, int on)
+{
+	size_t i;
+	int value = 0, sub = 0;
+
+	if (m->overflow)
+		return;
+	for (i = 0; i <= m->nparams; i++)
+	{
+		if (i == m->nparams || m->params[i] == ';')
+		{
+			modes_set(m, value, on);
+			value = 0;
+			sub = 0;
+		}
+		/* xterm.js dispatches the primary value of 1002:1. */
+		else if (m->params[i] == ':')
+			sub = 1;
+		else if (!sub && value < 100000)
+			value = value * 10 + (m->params[i] - '0');
+	}
+}
+
+static void
+modes_feed(struct modes *m, const unsigned char *buf, size_t len)
+{
+	size_t i;
+
+	for (i = 0; i < len; i++)
+	{
+		unsigned char c = buf[i];
+
+		/* CAN and SUB abort any sequence. */
+		if (c == 030 || c == 032)
+		{
+			m->parse = MP_GROUND;
+			continue;
+		}
+		switch (m->parse)
+		{
+		case MP_GROUND:
+			if (c == 033)
+				m->parse = MP_ESC;
+			break;
+		case MP_ESC:
+			m->parse = MP_GROUND;
+			if (c == '[')
+			{
+				m->parse = MP_CSI;
+				m->nparams = 0;
+				m->overflow = 0;
+			}
+			else if (c == ']' || c == 'P' || c == '_' || c == '^' ||
+				c == 'X')
+				m->parse = MP_STRING;
+			else if (c == 'c')
+				modes_reset(m);
+			else if (c == '=' || c == '>')
+				modes_set(m, 66, c == '=');
+			else if (c == 033)
+				m->parse = MP_ESC;
+			break;
+		case MP_CSI:
+		case MP_PARAMS:
+			if (c == '?' && m->parse == MP_CSI)
+				m->parse = MP_PRIVATE;
+			else if ((c >= '0' && c <= '9') || c == ';' || c == ':')
+				m->parse = MP_PARAMS;
+			else if (c == '!')
+				m->parse = MP_BANG;
+			else if (c == 033)
+				m->parse = MP_ESC;
+			else if (c >= 0x40 && c <= 0x7e)
+				m->parse = MP_GROUND;
+			else
+				m->parse = MP_IGNORE;
+			break;
+		case MP_PRIVATE:
+			if ((c >= '0' && c <= '9') || c == ';' || c == ':')
+			{
+				if (m->nparams < MODE_PARAMS)
+					m->params[m->nparams++] = c;
+				else
+					m->overflow = 1;
+			}
+			else if (c == 'h' || c == 'l')
+			{
+				modes_apply(m, c == 'h');
+				m->parse = MP_GROUND;
+			}
+			else if (c == 033)
+				m->parse = MP_ESC;
+			else if (c >= 0x40 && c <= 0x7e)
+				m->parse = MP_GROUND;
+			else
+				m->parse = MP_IGNORE;
+			break;
+		case MP_BANG:
+			if (c == 'p')
+				modes_soft_reset(m);
+			if (c == 033)
+				m->parse = MP_ESC;
+			else if (c >= 0x40 && c <= 0x7e)
+				m->parse = MP_GROUND;
+			else
+				m->parse = MP_IGNORE;
+			break;
+		case MP_IGNORE:
+			if (c == 033)
+				m->parse = MP_ESC;
+			else if (c >= 0x40 && c <= 0x7e)
+				m->parse = MP_GROUND;
+			break;
+		case MP_STRING:
+			if (c == 007)
+				m->parse = MP_GROUND;
+			else if (c == 033)
+				m->parse = MP_STRING_ESC;
+			break;
+		case MP_STRING_ESC:
+			/* ST ends the string; any other ESC starts a sequence. */
+			m->parse = MP_ESC;
+			if (c == '\\')
+				m->parse = MP_GROUND;
+			else
+				i--;
+			break;
+		}
+	}
+}
+
+static void
+sequence_add(char *out, size_t size, size_t *len, int mode, int on)
+{
+	int n = snprintf(out + *len, size - *len, "\033[?%d%c", mode,
+		on ? 'h' : 'l');
+
+	if (n > 0 && (size_t)n < size - *len)
+		*len += n;
+}
+
+/* Writes the sequence restoring every mode that differs from its default. */
+static size_t
+modes_sequence(const struct modes *m, char *out, size_t size)
+{
+	size_t i, len = 0;
+
+	for (i = 0; i < TRACKED_MODES; i++)
+	{
+		int on = (m->enabled >> i) & 1;
+
+		if (on != tracked_modes[i].initially)
+			sequence_add(out, size, &len, tracked_modes[i].mode, on);
+	}
+	if (m->mouse)
+		sequence_add(out, size, &len, m->mouse, 1);
+	if (m->encoding)
+		sequence_add(out, size, &len, m->encoding, 1);
+	return len;
+}
+
+/* Feeds count retained bytes starting at offset to a mode tracker. */
+static void
+history_feed(struct modes *m, size_t offset, size_t count)
+{
+	size_t start = (history_head + offset) % HISTORY_SIZE;
+	size_t first = HISTORY_SIZE - start;
+
+	if (first > count)
+		first = count;
+	modes_feed(m, history + start, first);
+	modes_feed(m, history, count - first);
+}
+
+static void
+history_record(const unsigned char *buf, size_t len)
+{
+	size_t evict, end, first;
+
+	evict = history_len + len > HISTORY_SIZE ?
+		history_len + len - HISTORY_SIZE : 0;
+	if (evict > history_len)
+	{
+		/* The new output alone overflows: keep its end only. */
+		history_feed(&history_base, 0, history_len);
+		history_head = history_len = 0;
+		modes_feed(&history_base, buf, len - HISTORY_SIZE);
+		buf += len - HISTORY_SIZE;
+		len = HISTORY_SIZE;
+		evict = 0;
+		history_truncated = 1;
+	}
+	if (evict > 0)
+	{
+		history_feed(&history_base, 0, evict);
+		history_head = (history_head + evict) % HISTORY_SIZE;
+		history_len -= evict;
+		history_truncated = 1;
+	}
+	end = (history_head + history_len) % HISTORY_SIZE;
+	first = HISTORY_SIZE - end;
+	if (first > len)
+		first = len;
+	memcpy(history + end, buf, first);
+	memcpy(history, buf + first, len - first);
+	history_len += len;
+}
+
+/* Writes everything to a non-blocking client, giving up if it stalls. */
+static int
+write_all(int fd, const void *data, size_t len)
+{
+	const unsigned char *p = data;
+
+	while (len > 0)
+	{
+		ssize_t n = write(fd, p, len);
+
+		if (n > 0)
+		{
+			p += n;
+			len -= n;
+		}
+		else if (n < 0 && errno == EAGAIN)
+		{
+			struct pollfd pfd;
+
+			int ready;
+
+			pfd.fd = fd;
+			pfd.events = POLLOUT;
+			ready = poll(&pfd, 1, HISTORY_STALL_MS);
+			if (ready == 0 || (ready < 0 && errno != EINTR))
+				return -1;
+		}
+		else if (n < 0 && errno != EINTR)
+			return -1;
+	}
+	return 0;
+}
+
+static int
+history_replay(int fd)
+{
+	struct modes modes = history_base;
+	char sequence[512];
+	size_t skip = 0, start, first, len;
+
+	/* A truncated history may begin inside a sequence or a character. */
+	if (history_truncated)
+	{
+		size_t i;
+
+		for (i = 0; i < history_len && i < HISTORY_ALIGN_LIMIT; i++)
+		{
+			if (history[(history_head + i) % HISTORY_SIZE] == '\n')
+			{
+				skip = i + 1;
+				break;
+			}
+		}
+		history_feed(&modes, 0, skip);
+	}
+	len = history_len - skip;
+	start = (history_head + skip) % HISTORY_SIZE;
+	first = HISTORY_SIZE - start;
+	if (first > len)
+		first = len;
+	if (write_all(fd, HISTORY_BEGIN, sizeof(HISTORY_BEGIN) - 1) < 0 ||
+		write_all(fd, sequence,
+			modes_sequence(&modes, sequence, sizeof(sequence))) < 0 ||
+		write_all(fd, history + start, first) < 0 ||
+		write_all(fd, history, len - first) < 0 ||
+		write_all(fd, HISTORY_END, sizeof(HISTORY_END) - 1) < 0)
+		return -1;
+	return 0;
+}
