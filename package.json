{
  "name": "soreno",
  "private": true,
  "version": "1.2.12",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "build:exe": "sh ./scripts/build-windows-portable.sh",
    "build:linux": "tauri build --bundles appimage,deb,rpm",
    "build:mac": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "build:relay": "sh ./scripts/build-relay.sh",
    "build:remote": "node ./scripts/build-remote.mjs",
    "build:windows": "sh ./scripts/tauri-wsl.sh build",
    "dev:mobile": "sh ./scripts/dev-mobile.sh",
    "dev:windows": "sh ./scripts/tauri-wsl.sh dev",
    "preview": "vite preview",
    "release": "node ./scripts/release.mjs",
    "format": "prettier src --write",
    "format:check": "prettier src --check",
    "test": "vitest run",
    "test:scripts": "sh ./scripts/launchers.test.sh && node --test ./scripts/release.selftest.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@fontsource-variable/inter": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.21.0",
    "material-icon-theme": "^5.39.0",
    "micromark-util-decode-string": "^2.0.1",
    "pele": "^1.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "26.1.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"
  }
}
